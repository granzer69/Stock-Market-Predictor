# Backend market data (see DEPLOY.md)
# MARKET_DATA_PROVIDER=yahoo
# MARKET_DATA_PROVIDER=nse_csv
# NSE_CSV_DIR=/path/to/nse_daily_csvs

# Yahoo + TensorFlow in one process
YF_DISABLE_CURL_CFFI=1

# Next.js → API (Docker / Vercel)
# API_ORIGIN=http://127.0.0.1:8000

# Production CORS (comma-separated)
# CORS_ORIGINS=https://desk.example.com,http://localhost:3000

# MARKET_DATA_FAILOVER=true
# PAPER_APPLY_INDIA_COSTS=false
# BACKTEST_FILL=close
# RESEARCH_MAX_CONCURRENT=2
# PAPER_DB_PATH=/app/backend/data/paper/paper_trading.db
